{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "headfwd-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-25",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
	},
	"routes": [
		{
			"pattern": "headfwd.net/*",
			"zone_id": "0abcdb39c09412dac7599f752ab8ed88",
		},
		{
			"pattern": "*.headfwd.net/*",
			"zone_id": "0abcdb39c09412dac7599f752ab8ed88",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "TUNNELS",
				"class_name": "HeadscaleTunnel",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["HeadscaleTunnel"],
		},
	],
	"kv_namespaces": [
		{
			"binding": "REGISTRY",
			"id": "3df9e6238df44a548bea4936b1a9a64b",
			"remote": true,
		},
	],
}
